# ==============================================================================
# Lakehouse Architect / Modern Data Engineer Environment Variables Example
# ==============================================================================

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://moderndataengineer.uk

# Public CDN URL for serving static artifacts from Cloudflare R2 / CDN
NEXT_PUBLIC_CDN_URL=https://assets.moderndataengineer.uk

# Cloudflare Turnstile CAPTCHA (Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFgJ82U17SKQAtZs

# Clerk Authentication (Optional)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Upstash Redis & Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
