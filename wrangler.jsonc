{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "lakehouse-architect",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lakehouse-architect"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "lakehouse-next-cache"
    },
    {
      "binding": "ARTIFACTS_BUCKET",
      "bucket_name": "lakehouse-artifacts"
    }
  ],
  "routes": [
    {
      "pattern": "moderndataengineer.uk",
      "custom_domain": true
    },
    {
      "pattern": "www.moderndataengineer.uk",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://moderndataengineer.uk",
    "NEXT_PUBLIC_CDN_URL": "",
    "ARTIFACT_VERSION": "v2026.10",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFgJ82U17SKQAtZs"
  }
}
